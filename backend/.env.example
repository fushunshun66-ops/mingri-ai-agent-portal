# ===========================================
# 企业智能体统一门户 — 环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# ===========================================

# 应用基础配置
APP_NAME=agent-portal
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_TIMEZONE=Asia/Shanghai

# 数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me_in_prod
DATABASE_URL=postgresql+asyncpg://portal:change_me_in_prod@localhost:5432/agent_portal

# 测试数据库
TEST_DATABASE_URL=postgresql+asyncpg://portal:change_me_in_prod@localhost:5432/agent_portal_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_prod
REDIS_URL=redis://:change_me_in_prod@localhost:6379/0

# JWT 认证（开发环境使用 HS256）
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 加密
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 限流
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=text

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 服务端口
API_PORT=8000
